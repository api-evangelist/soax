          "name": "Fetch Web Content",
          "request": {
            "name": "Fetch Web Content",
            "description": {
              "content": "Fetch fully rendered content from any public web page. Handles JavaScript execution, CAPTCHA bypass, anti-bot circumvention, and headless browser management automatically. Returns HTML body, screenshots, XHR calls, or Markdown depending on response configuration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "webdata",
                "fetch-content"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"<uri>\",\n  \"proxy_settings\": {\n    \"country\": \"<string>\",\n    \"type\": \"<integer>\",\n    \"city\": \"<string>\",\n    \"region\": \"<string>\",\n    \"isp\": \"<string>\"\n  },\n  \"response\": {\n    \"body\": true,\n    \"screenshot\": false,\n    \"xhr\": false,\n    \"markdown\": false\n  },\n  \"session\": {\n    \"sticky\": false,\n    \"session_id\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
