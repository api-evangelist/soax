                      "raw": "{\n  \"url\": \"<uri>\",\n  \"proxy_settings\": {\n    \"country\": \"<string>\",\n    \"type\": 2,\n    \"city\": \"<string>\",\n    \"region\": \"<string>\",\n    \"isp\": \"<string>\"\n  },\n  \"response\": {\n    \"body\": true,\n    \"screenshot\": false,\n    \"xhr\": false,\n    \"markdown\": false\n  },\n  \"session\": {\n    \"sticky\": false,\n    \"session_id\": \"<string>\"\n  }\n}",
